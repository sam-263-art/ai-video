import { NextResponse } from "next/server";

export async function POST(req: Request) {
  try {
    const body = await req.json();
    const mode = body.mode || "text2video";

    let apiUrl = "";
    let apiBody: any = {};

    const common = {
      model: body.model || "viduq3-pro",
      duration: body.duration || 5,
      resolution: body.resolution || "540p",
      aspect_ratio: body.aspect_ratio || "16:9",
      movement_amplitude: "auto",
      off_peak: false,
      seed: 0,
    };

    // ── 文字生成视频 ──
    if (mode === "text2video") {
      apiUrl = "https://api.vidu.cn/ent/v2/text2video";
      apiBody = {
        ...common,
        style: "general",
        prompt: body.prompt,
      };

    // ── 图片生成视频 / 产品展示 / 人物说话 ──
	  } else if (mode === "img2video" || mode === "product" || mode === "talking") {
	  const imageUrl = await uploadToImgbb(body.first_frame);
	  apiUrl = "https://api.vidu.cn/ent/v2/img2video";
	  apiBody = {
	  	...common,
	  	prompt: body.prompt,
	  	images: [imageUrl],
	  };
	  } else if (mode === "firstlast") {
	  const firstUrl = await uploadToImgbb(body.first_frame);
	  const lastUrl = await uploadToImgbb(body.last_frame);
	  apiUrl = "https://api.vidu.cn/ent/v2/img2video";
	  apiBody = {
	  	...common,
	  	prompt: body.prompt,
	  	images: [firstUrl, lastUrl],
	  };

    } else {
      return NextResponse.json({ error: "不支持的模式: " + mode }, { status: 400 });
    }

    console.log("调用接口:", apiUrl, "模式:", mode);

    const createResponse = await fetch(apiUrl, {
      method: "POST",
      headers: {
        Authorization: `Token ${process.env.VIDU_API_KEY}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(apiBody),
    });

    const createResult = await createResponse.json();
    console.log("images字段预览:", JSON.stringify(apiBody.images?.[0])?.slice(0, 100));

    const taskId = createResult.task_id || createResult.id;

    if (!taskId) {
      return NextResponse.json(
        { error: createResult.message || "没有获取到 task_id" },
        { status: 500 }
      );
    }

    return NextResponse.json({ task_id: taskId });

  } catch (error: any) {
    console.error(error);
    return NextResponse.json({ error: error.message }, { status: 500 });
  }
}

async function uploadToImgbb(base64: string): Promise<string> {
  const pureBase64 = base64.replace(/^data:image\/\w+;base64,/, "");
  const form = new URLSearchParams();
  form.append("key", process.env.IMGBB_API_KEY || "");
  form.append("image", pureBase64);

  const res = await fetch("https://api.imgbb.com/1/upload", {
    method: "POST",
    body: form,
  });
  const data = await res.json();
  if (!data.success) throw new Error("图片上传失败: " + data.error?.message);
  return data.data.url;
}
