import { NextResponse } from "next/server";

export async function POST(req: Request) {

  try {

    const body = await req.json();

    // 1 创建任务
    const createResponse = await fetch(
      "https://api.vidu.cn/ent/v2/text2video",
      {
        method: "POST",
        headers: {
          Authorization:
            `Token ${process.env.VIDU_API_KEY}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          model: "viduq3-pro",
          style: "general",
          prompt: body.prompt,
          duration: 5,
          seed: 0,
          aspect_ratio: "4:3",
          resolution: "540p",
          movement_amplitude: "auto",
          off_peak: false,
        }),
      }
    );

    const createResult =
      await createResponse.json();

    console.log("创建任务:", createResult);

    const taskId =
      createResult.task_id ||
      createResult.id;

    if (!taskId) {

      return NextResponse.json(
        {
          error: "没有获取到 task_id",
        },
        {
          status: 500,
        }
      );
    }

    // 2 轮询任务
    let videoUrl = "";

    for (let i = 0; i < 60; i++) {

      console.log(`查询第 ${i + 1} 次`);

      await new Promise((r) =>
        setTimeout(r, 5000)
      );

	const taskResponse = await fetch(
	`https://api.vidu.cn/ent/v2/tasks/${taskId}/creations`,
	{
		method: "GET",
		headers: {
		Authorization: `Token ${process.env.VIDU_API_KEY}`,
		},
	}
	);
	
	const rawText = await taskResponse.text();
	console.log(`第 ${i + 1} 次查询原始返回:`, rawText);
	
	let taskResult;
	try {
	taskResult = JSON.parse(rawText);
	} catch (e) {
	console.error("非 JSON，跳过:", rawText);
	continue;
	}

      // 任务成功
      if (
        taskResult.state === "success"
      ) {

        videoUrl =
		  taskResult.creations?.[0]?.url ||
          taskResult.creations?.[0]?.video_url ||
          taskResult.video_url ||
          "";

        break;
      }

      // 任务失败
      if (
        taskResult.state === "failed"
      ) {

        return NextResponse.json(
          {
            error: "视频生成失败",
          },
          {
            status: 500,
          }
        );
      }
    }

    if (!videoUrl) {

      return NextResponse.json(
        {
          error: "视频生成超时",
        },
        {
          status: 500,
        }
      );
    }

    // 3 返回视频
    return NextResponse.json({
      video: videoUrl,
    });

  } catch (error: any) {

    console.error(error);

    return NextResponse.json(
      {
        error: error.message,
      },
      {
        status: 500,
      }
    );
  }
}